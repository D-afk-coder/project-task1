' uml_class_diagram.puml
'
' Simplified UML class diagram for the turtlebot3_drive executable (the
' WallFollower node), drawn to the unit's standard (Lec 2A): classes and their
' relationships only, with no member variables or functions, including the
' relationships between our classes and the ROS classes they use.
'
'   CWallFollowerNode is a Node (inheritance) and owns its ROS connections,
'   its CLidar and its CWallFollower (composition): it creates them and they
'   are destroyed with it.
'   CLidar owns the latest CWallDistances it measured.
'   CWallFollower owns one of each drive behaviour, and knows which one is in
'   charge (association, through a pointer to the base class).
'   Each behaviour is a CDriveBehaviour (inheritance).
'
' CVelocity is not drawn: it is a plain value returned from one call to the
' next and never kept by any class, so it has no relationship to show.

@startuml
skinparam classAttributeIconSize 0
skinparam style strictuml
skinparam genericDisplay old

package "WallFollower node (turtlebot3_drive executable)" <<Frame>> {

  class "rclcpp::Node" as Node
  class "rclcpp::Publisher<TwistStamped>" as Publisher
  class "rclcpp::Subscription<LaserScan>" as Subscription
  class "rclcpp::TimerBase" as TimerBase

  class CWallFollowerNode
  class CLidar
  class CWallDistances
  class CWallFollower
  class CDriveBehaviour
  class CFollowWall
  class CTurnLeft
  class CSeekWall
  class CStop

  ' Inheritance : is a
  CWallFollowerNode -up-|> Node
  CFollowWall -up-|> CDriveBehaviour
  CTurnLeft -up-|> CDriveBehaviour
  CSeekWall -up-|> CDriveBehaviour
  CStop -up-|> CDriveBehaviour

  ' Composition : has a, owns (diamond on the owner)
  CWallFollowerNode *-- Publisher
  CWallFollowerNode *-- Subscription
  CWallFollowerNode *-- TimerBase
  CWallFollowerNode *-- CLidar
  CWallFollowerNode *-- CWallFollower
  CLidar *-- CWallDistances
  CWallFollower *-- CFollowWall
  CWallFollower *-- CTurnLeft
  CWallFollower *-- CSeekWall
  CWallFollower *-- CStop

  ' Association : knows a
  CWallFollower -right-> CDriveBehaviour
}
@enduml
